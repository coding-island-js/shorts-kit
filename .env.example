# Copy this file to .env and fill in what you want. .env is gitignored.
# Nothing here is required to make your first Short.

# Stock b-roll. Free, no card: https://www.pexels.com/api/
PEXELS_API_KEY=
# Fallback stock source. Free: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Voice. Default is the free Microsoft Edge voice, no key needed.
# List voices: python -m edge_tts --list-voices
EDGE_TTS_VOICE=en-US-AndrewMultilingualNeural

# Optional premium voice: set TTS_ENGINE=openai and add a key.
# About a cent per Short. https://platform.openai.com/api-keys
TTS_ENGINE=edge
OPENAI_API_KEY=
OPENAI_VOICE=nova

# YouTube upload does not use a key here. It uses client_secret.json in the
# repo root. See docs/youtube-setup.md
